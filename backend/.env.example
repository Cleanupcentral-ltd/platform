NODE_ENV=development
HOST=127.0.0.1
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

WIX_API_KEY=replace-with-a-private-wix-api-key
WIX_SITE_ID=replace-with-your-wix-site-id
WIX_API_BASE_URL=https://www.wixapis.com

# Transactional email notifications
# Keep disabled until Build 7C live verification.
NOTIFICATIONS_ENABLED=false
NOTIFICATION_BUSINESS_NAME=Clean Up Central
NOTIFICATION_FROM_NAME=Clean Up Central
NOTIFICATION_FROM_EMAIL=notifications@your-verified-domain.example
CUSTOMER_REPLY_TO_EMAIL=support@your-verified-domain.example
INTERNAL_NOTIFICATION_EMAILS=operations@your-verified-domain.example
RESEND_API_KEY=replace-with-a-private-resend-api-key
RESEND_API_BASE_URL=https://api.resend.com
NOTIFICATION_TIMEOUT_MS=10000

# Automatic travel calculation (safe default: disabled)
TRAVEL_AUTO_ENABLED=false
GOOGLE_ROUTES_API_KEY=replace-with-a-private-google-routes-api-key
GOOGLE_ROUTES_API_BASE_URL=https://routes.googleapis.com
GOOGLE_ROUTES_TIMEOUT_MS=5000
