NODE_ENV=development
HOST=127.0.0.1
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

WIX_API_KEY=replace-with-a-private-wix-api-key
WIX_SITE_ID=replace-with-your-wix-site-id
WIX_API_BASE_URL=https://www.wixapis.com

# Transactional email notifications
# Keep disabled until Build 7C live verification.
NOTIFICATIONS_ENABLED=false
NOTIFICATION_BUSINESS_NAME=Clean Up Central
NOTIFICATION_FROM_NAME=Clean Up Central
NOTIFICATION_FROM_EMAIL=notifications@your-verified-domain.example
CUSTOMER_REPLY_TO_EMAIL=support@your-verified-domain.example
INTERNAL_NOTIFICATION_EMAILS=operations@your-verified-domain.example
RESEND_API_KEY=replace-with-a-private-resend-api-key
RESEND_API_BASE_URL=https://api.resend.com
NOTIFICATION_TIMEOUT_MS=10000

# Automatic travel calculation (safe default: disabled)
TRAVEL_AUTO_ENABLED=false
GOOGLE_ROUTES_API_KEY=replace-with-a-private-google-routes-api-key
GOOGLE_ROUTES_API_BASE_URL=https://routes.googleapis.com
GOOGLE_ROUTES_TIMEOUT_MS=5000

# Lead Engine Lite (safe default: all capabilities disabled)
LEAD_ENGINE_UI_V1=false
LEAD_SEARCH_GOOGLE_V1=false
LEAD_COMPANIES_HOUSE_V1=false
LEAD_AUTO_COMPANY_ENRICHMENT_V1=false
LEAD_AUTOMATIC_QUALIFICATION_V1=false
LEAD_AUTOMATIC_QUALIFICATION_ROLLOUT=canary
LEAD_CHARITY_COMMISSION_V1=false
CHARITY_COMMISSION_API_KEY=
# Copy the non-secret API base URL from the Charity Commission Developer Hub API details.
CHARITY_COMMISSION_API_BASE_URL=
CHARITY_COMMISSION_TIMEOUT_MS=8000
LEAD_COMPANY_ENRICHMENT_INTERVAL_MS=60000
LEAD_COMPANY_ENRICHMENT_BATCH_SIZE=5
LEAD_COMPANY_ENRICHMENT_LEASE_SECONDS=180
LEAD_WEBSITE_LOOKUP_TIMEOUT_MS=5000
LEAD_WEBSITE_LOOKUP_MAX_BYTES=524288
LEAD_WEBSITE_RESEARCH_MAX_PAGES=6
LEAD_WEBSITE_REQUEST_RETRIES=1
COMPANIES_HOUSE_API_KEY=
COMPANIES_HOUSE_API_BASE_URL=https://api.company-information.service.gov.uk
COMPANIES_HOUSE_TIMEOUT_MS=8000
LEAD_OUTLOOK_DRAFT_V1=false
LEAD_EXPORT_V1=false

# Required only when LEAD_SEARCH_GOOGLE_V1=true.
# Both keys are server-only and must never be exposed to the browser.
GOOGLE_PLACES_API_KEY=replace-with-a-private-google-places-api-key
GOOGLE_PLACES_API_BASE_URL=https://places.googleapis.com/v1
GOOGLE_PLACES_TIMEOUT_MS=8000
POSTCODES_IO_API_BASE_URL=https://api.postcodes.io
POSTCODES_IO_TIMEOUT_MS=5000
SUPABASE_SECRET_KEY=replace-with-a-private-supabase-secret-key
SUPABASE_DATA_TIMEOUT_MS=8000

# Required only when LEAD_ENGINE_UI_V1=true
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-a-publishable-key
SUPABASE_AUTH_TIMEOUT_MS=5000
LEAD_ENGINE_CONSOLE_ORIGIN=https://app.cleanupcentral.com
